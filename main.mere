// mq — a jq-like JSON query & transform CLI, compiled to a NATIVE binary
// via the Mere C backend (mere -c | clang). Second dogfood app (PAIN.md).
//
// M3: streams — pipes and array/object iteration.
//   mq '<query>' <file.json>
//   .              identity
//   .a.b           field access
//   .items[0]      array index
//   .[]            iterate: array elements / object values (one per line)
//   .items[] | .id   pipe: for each item, take .id
//
// A query is a flat sequence of selectors (Field | Index | Iter); `|` and
// spaces just separate them (`.a | .b` ≡ `.a.b`). Evaluation is
// stream-based: it starts with [input] and flat-maps each selector, so
// `.[]` turns one value into many. Each result value is printed on its
// own line.
//
// Build:
//   mere install
//   mere -c main.mere > mq.c && clang mq.c -o mq
//   ./mq '.items[] | .id' data.json

import "json/json.mere";

// NOTE: contrib/csv/parser.mere is NOT imported. Composing it with
// json.mere breaks the C backend's inner-function lifting (a captured
// `n` is dropped from a lifted loop — see PAIN P8). Until that's fixed
// upstream, mq parses CSV with a small str_split-based reader below
// (top-level recursion only, no inner-lifted loops). Trade-off: no
// quoted-field / embedded-comma handling yet.

type sel = Field of str | Index of int | Iter;

let rec nth_or = fn xs -> fn i -> fn d ->
  match xs with
  | Nil -> d
  | Cons (x, t) -> if i <= 0 then x else nth_or t (i - 1) d;

// --- query parsing: string → sel list -----------------------------------
// `ord`-based char classes (`>=`/`<=` don't typecheck on str — PAIN P7).

let is_dig = fn c -> let o = ord c in o >= 48 && o <= 57;
let is_id  = fn c ->
  let o = ord c in
  (o >= 97 && o <= 122) || (o >= 65 && o <= 90) || (o >= 48 && o <= 57) || o == 95;

let rec scan_ident = fn q -> fn i -> fn n ->
  if i < n && is_id (char_at q i) then scan_ident q (i + 1) n else i;

let rec scan_int = fn q -> fn i -> fn n -> fn acc ->
  if i < n && is_dig (char_at q i) then
    scan_int q (i + 1) n (acc * 10 + (ord (char_at q i) - 48))
  else (acc, i);

let rec parse_q = fn q -> fn i -> fn n ->
  if i >= n then Nil
  else
    let c = char_at q i in
    if c == " " || c == "|" then parse_q q (i + 1) n        // skip separators
    else if c == "." then
      (if i + 1 >= n then Nil                               // trailing "." = identity
       else if char_at q (i + 1) == "[" then parse_bracket q (i + 1) n
       else parse_fld q (i + 1) n)
    else if c == "[" then parse_bracket q i n
    else Nil                                                // unknown → stop
and parse_fld = fn q -> fn i -> fn n ->
  let j = scan_ident q i n in
  if j == i then parse_q q i n                              // no ident here → resume
  else Cons (Field (substring q i j), parse_q q j n)
and parse_bracket = fn q -> fn i -> fn n ->                 // q[i] == '['
  if i + 1 < n && char_at q (i + 1) == "]" then
    Cons (Iter, parse_q q (i + 2) n)                        // []
  else
    match scan_int q (i + 1) n 0 with
    | (num, j) ->
      let j2 = if j < n && char_at q j == "]" then j + 1 else j in
      Cons (Index num, parse_q q j2 n);

// --- navigating a Json.json value ---------------------------------------

let rec obj_get = fn ps -> fn k ->
  match ps with
  | Nil -> Json.JNull
  | Cons ((k2, v), t) -> if k2 == k then v else obj_get t k;

let rec arr_get = fn xs -> fn idx ->
  match xs with
  | Nil -> Json.JNull
  | Cons (x, t) -> if idx <= 0 then x else arr_get t (idx - 1);

let rec vals_of = fn ps ->
  match ps with
  | Nil -> Nil
  | Cons ((k, v), t) -> Cons (v, vals_of t);

let field_of = fn v -> fn k ->
  match v with
  | Json.JObj ps -> obj_get ps k
  | _ -> Json.JNull;

let index_of = fn v -> fn idx ->
  match v with
  | Json.JArr xs -> arr_get xs idx
  | _ -> Json.JNull;

let iter_of = fn v ->
  match v with
  | Json.JArr xs -> xs
  | Json.JObj ps -> vals_of ps
  | _ -> Nil;

// --- stream evaluation --------------------------------------------------

let rec concat = fn a -> fn b ->
  match a with
  | Nil -> b
  | Cons (x, t) -> Cons (x, concat t b);

let rec step = fn stream -> fn s ->
  match stream with
  | Nil -> Nil
  | Cons (v, t) ->
    (match s with
     | Field k -> Cons (field_of v k, step t s)
     | Index i -> Cons (index_of v i, step t s)
     | Iter    -> concat (iter_of v) (step t s));

let rec run = fn stream -> fn sels ->
  match sels with
  | Nil -> stream
  | Cons (s, t) -> run (step stream s) t;

// --- serialising a Json.json value --------------------------------------

let rec ser = fn v ->
  match v with
  | Json.JNull -> "null"
  | Json.JBool b -> if b then "true" else "false"
  | Json.JNum n -> show n
  | Json.JStr s -> "\"" ++ s ++ "\""
  | Json.JArr xs -> "[" ++ ser_arr xs ++ "]"
  | Json.JObj ps -> "\{" ++ ser_obj ps ++ "}"
and ser_arr = fn xs ->
  match xs with
  | Nil -> ""
  | Cons (x, Nil) -> ser x
  | Cons (x, t) -> ser x ++ "," ++ ser_arr t
and ser_obj = fn ps ->
  match ps with
  | Nil -> ""
  | Cons ((k, v), Nil) -> "\"" ++ k ++ "\":" ++ ser v
  | Cons ((k, v), t) -> "\"" ++ k ++ "\":" ++ ser v ++ "," ++ ser_obj t;

let rec print_each = fn xs ->
  match xs with
  | Nil -> ()
  | Cons (v, t) -> let _ = print (ser v) in print_each t;

// --- CSV → JSON (--csv mode) --------------------------------------------
// Rows are str-lists (Csv.parse_csv). The first row is the header; each
// data row becomes a JObj mapping header → JStr cell. Result is a JArr,
// so `.[] | .col` queries it like any JSON array.

let rec zip_obj = fn hs -> fn cs ->
  match hs with
  | Nil -> Nil
  | Cons (h, ht) ->
    (match cs with
     | Nil -> Cons ((h, Json.JStr ""), zip_obj ht Nil)
     | Cons (c, ct) -> Cons ((h, Json.JStr c), zip_obj ht ct));

// Drop a trailing empty row (a file ending in "\n" parses to a final [""]).
let is_blank_row = fn r ->
  match r with
  | Nil -> true
  | Cons (c, Nil) -> c == ""
  | _ -> false;

let rec rows_to_objs = fn hdr -> fn rows ->
  match rows with
  | Nil -> Nil
  | Cons (r, t) ->
    if is_blank_row r then rows_to_objs hdr t
    else Cons (Json.JObj (zip_obj hdr r), rows_to_objs hdr t);

let csv_to_json = fn rows ->
  match rows with
  | Nil -> Json.JArr Nil
  | Cons (hdr, data) -> Json.JArr (rows_to_objs hdr data);

// Minimal CSV reader: split on newlines, then each line on commas.
// (No quoted-field support — see the note at the top / PAIN P8.)
let rec split_lines = fn lines ->
  match lines with
  | Nil -> Nil
  | Cons (l, t) -> Cons (str_split l ",", split_lines t);

let csv_rows = fn src -> split_lines (str_split src "\n");

// --- main ---------------------------------------------------------------

let a = args () in
let is_csv = (nth_or a 0 "") == "--csv" in
let query = if is_csv then nth_or a 1 "" else nth_or a 0 "" in
let path  = if is_csv then nth_or a 2 "" else nth_or a 1 "" in
if path == "" then
  let _ = print "usage: mq [--csv] '<query>' <file>" in 1
else
  let src = read_file path in
  let v = if is_csv then csv_to_json (csv_rows src)
          else Json.parse_json src in
  let sels = parse_q query 0 (str_len query) in
  let _ = print_each (run (Cons (v, Nil)) sels) in
  0
